{"nodes": [{"id": "prompts_automatedmssg_evolution_api", "label": "Evolution API (unofficial WhatsApp API)", "file_type": "concept", "source_file": "prompts/automatedmssg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_automatedmssg_docker_compose_deployment", "label": "Evolution API docker-compose deployment", "file_type": "concept", "source_file": "prompts/automatedmssg.md", "source_location": "lines 7-11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as the fastest secure path onto a Linux server; required env covers the global API token, webhook features and the data store."}, {"id": "prompts_automatedmssg_global_api_token", "label": "Evolution API global API token", "file_type": "concept", "source_file": "prompts/automatedmssg.md", "source_location": "line 10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_automatedmssg_qr_instance_pairing", "label": "WhatsApp QR instance pairing via Manager dashboard", "file_type": "concept", "source_file": "prompts/automatedmssg.md", "source_location": "line 11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dedicated WhatsApp Business SIM is paired by QR scan so school traffic never runs through a personal number."}, {"id": "prompts_automatedmssg_anti_ban_architecture", "label": "Anti-ban messaging architecture", "file_type": "rationale", "source_file": "prompts/automatedmssg.md", "source_location": "lines 15-28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Meta's anti-spam filters ban numbers that blast messages in tight loops, so the design forbids synchronous foreach sends, pushes every message through a queued job, and spaces sends with randomized human-like gaps to keep the unofficial number alive."}, {"id": "prompts_automatedmssg_staggered_cumulative_delay", "label": "Staggered cumulative randomized delay (5-10s)", "file_type": "rationale", "source_file": "prompts/automatedmssg.md", "source_location": "lines 20-25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sleep() inside the job would block the queue worker, so the dispatcher accumulates a random 5-10 second offset per message and passes it to Laravel's ->delay(), giving human-like pacing (0s, 7s, 15s, 21s, ...) without holding a worker hostage."}, {"id": "prompts_automatedmssg_sendwhatsappmessage_job", "label": "SendWhatsAppMessage queued job", "file_type": "code", "source_file": "prompts/automatedmssg.md", "source_location": "line 30", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_automatedmssg_graceful_failure_handling", "label": "Graceful try/catch around the Evolution API call", "file_type": "rationale", "source_file": "prompts/automatedmssg.md", "source_location": "line 26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unofficial API endpoint will go down, time out or return bad statuses; the job logs the failure and returns instead of throwing, so one dead endpoint cannot take the whole queue system with it."}, {"id": "prompts_automatedmssg_message_sendtext_endpoint", "label": "Evolution API /message/sendText endpoint", "file_type": "concept", "source_file": "prompts/automatedmssg.md", "source_location": "line 27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Called with Laravel's Http::withToken()->post() facade rather than a custom client, so the token handling and timeouts stay standard."}, {"id": "prompts_automatedmssg_send_fee_reminders_command", "label": "app:send-fee-reminders Artisan command", "file_type": "code", "source_file": "prompts/automatedmssg.md", "source_location": "line 31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Queries students owing money and queues one delayed SendWhatsAppMessage per debtor; it owns the delay accumulation so the job itself stays stateless."}, {"id": "prompts_automatedmssg_fee_reminder", "label": "Automated fee reminder to students", "file_type": "concept", "source_file": "prompts/automatedmssg.md", "source_location": "line 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_automatedmssg_staff_registration_alert", "label": "Staff registration alert on new student", "file_type": "concept", "source_file": "prompts/automatedmssg.md", "source_location": "line 32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dispatched instantly (no delay) when a student is created via Filament, since it is a single message to staff rather than a bulk send and carries no ban risk."}, {"id": "prompts_automatedmssg_student", "label": "Student model", "file_type": "code", "source_file": "prompts/automatedmssg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_automatedmssg_filament_panel", "label": "Filament admin panel (student creation trigger)", "file_type": "code", "source_file": "prompts/automatedmssg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "prompts_automatedmssg_anti_ban_architecture", "target": "prompts_automatedmssg_staggered_cumulative_delay", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/automatedmssg.md", "source_location": "lines 18-25", "weight": 1.0}, {"source": "prompts_automatedmssg_staggered_cumulative_delay", "target": "prompts_automatedmssg_sendwhatsappmessage_job", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/automatedmssg.md", "source_location": "lines 20-25", "we