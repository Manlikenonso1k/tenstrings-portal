{"nodes": [{"id": "prompts_handsoff", "label": "WhatsApp fee reminders agent handoff", "file_type": "document", "source_file": "prompts/handsoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_handsoff_whatsapp_fee_reminders", "label": "Automated WhatsApp fee reminders", "file_type": "rationale", "source_file": "prompts/handsoff.md", "source_location": "Current Project State", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built on the unofficial Evolution API specifically to bypass Meta's official API constraints - no message templates and no per-message fees. MD approved two automated messages per week to debtors after the due date."}, {"id": "prompts_handsoff_send_whatsapp_message_job", "label": "SendWhatsAppMessage job", "file_type": "code", "source_file": "prompts/handsoff.md", "source_location": "2. Laravel Portal App", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_handsoff_send_fee_reminders_command", "label": "app:send-fee-reminders command", "file_type": "code", "source_file": "prompts/handsoff.md", "source_location": "2. Laravel Portal App", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dispatches the queued job with a cumulative staggered delay so messages go out sequentially rather than in a burst that looks like spam to WhatsApp."}, {"id": "prompts_handsoff_ec2_t3_small_upgrade", "label": "EC2 t3.small upgrade and redis container", "file_type": "rationale", "source_file": "prompts/handsoff.md", "source_location": "1. Evolution API (AWS Server)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The instance was upgraded from t3.micro (1GB) to t3.small (2GB) because the internal Baileys engine crashed from lack of memory while generating the QR code, and a redis container was added to docker-compose.yml to stop a continuous crash loop. The upgrade changed the public IP to 16.171.12.145."}, {"id": "prompts_handsoff_hostinger_deploy_tasks", "label": "Pending Hostinger deploy tasks", "file_type": "document", "source_file": "prompts/handsoff.md", "source_location": "Pending Tasks on Hostinger", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Update .env with the new IP and token, git pull origin main, then php artisan queue:restart - the queue worker holds the old config until restarted."}, {"id": "prompts_handsoff_student_import_template_csv", "label": "student_import_template.csv", "file_type": "concept", "source_file": "prompts/handsoff.md", "source_location": "The CSV / Data Import Request", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reminder sending needs debtor student data, so a template CSV was generated for the user to fill and an import command is the next agent's task."}], "edges": [{"source": "prompts_handsoff", "target": "prompts_handsoff_whatsapp_fee_reminders", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/handsoff.md", "source_location": "Current Project State", "weight": 1.0}, {"source": "prompts_handsoff_whatsapp_fee_reminders", "target": "prompts_aws_evolution_setup_evolution_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/handsoff.md", "source_location": "1. Evolution API (AWS Server)", "weight": 1.0}, {"source": "prompts_handsoff_send_fee_reminders_command", "target": "prompts_handsoff_send_whatsapp_message_job", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/handsoff.md", "source_location": "2. Laravel Portal App", "weight": 1.0}, {"source": "prompts_handsoff_send_whatsapp_message_job", "target": "prompts_aws_evolution_setup_send_text_endpoint", "relation": "calls", "confidence": "EXTRACTE