{"nodes": [{"id": "readme_tenstrings_portal", "label": "Tenstrings Portal", "file_type": "document", "source_file": "README.md", "source_location": "README.md:1-3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A comprehensive music school management system built on Laravel 12 and Filament PHP v3, chosen to get admin/instructor/student back-office UI without hand-building CRUD."}, {"id": "readme_multi_panel_architecture", "label": "Multi-Panel Architecture", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate Filament panels for Admins, Instructors, and Students keep role-specific surfaces and guards isolated rather than gating one shared panel by permission."}, {"id": "readme_student_management", "label": "Student Management", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full lifecycle management from admission to graduation."}, {"id": "readme_academic_core", "label": "Academic Core", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Course modules, unlocked lesson progressions, grading, and attendance tracking form the academic domain."}, {"id": "readme_lesson_unlock_logic", "label": "Unlocked Lesson Progression", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:9,30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lessons unlock progressively; the mobile courses endpoints must respect the same unlock logic as the web portal so the API cannot be used to skip ahead."}, {"id": "readme_financials", "label": "Financials and Fee Workflows", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integrated fee workflows, invoice generation, and live payments via Paystack and TGIPay."}, {"id": "readme_paystack_integration", "label": "Paystack Payment Gateway", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tgipay_integration", "label": "TGIPay Payment Gateway", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_mobile_api_v1", "label": "Stateless Mobile API v1", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:11,15-22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fully stateless, token-based v1 RESTful API in routes/api.php for a companion mobile app; responses are standardized JSON wrapped in API Resources so the mobile client sees a stable contract independent of Eloquent model shape."}, {"id": "readme_laravel_sanctum", "label": "Laravel Sanctum Bearer Token Auth", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:17,21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sanctum bearer tokens protect the API; its migrations ship with the standard migrate run."}, {"id": "readme_guard_separation", "label": "API/Filament Guard Separation", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The token API is strictly separated from the web portal's session-based Filament guards, so adding mobile auth cannot break existing admin panel logins; deployments touching guards require optimize:clear."}, {"id": "readme_endpoint_auth", "label": "Auth Endpoints (/auth)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Login, Logout, Token Refresh, and Profile (/me)."}, {"id": "readme_endpoint_student_profile", "label": "Student Profile Endpoints (/student)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately limited profile editing plus avatar upload and document links, so the mobile app cannot mutate registrar-controlled fields."}, {"id": "readme_endpoint_courses", "label": "Courses Endpoints (/courses)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:30", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_endpoint_grades", "label": "Grades Endpoints (/grades)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exposes assessment scores plus server-side GPA summary calculation so the client does not reimplement grading math."}, {"id": "readme_endpoint_attendance", "label": "Attendance Endpoints (/attendance)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:32", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_endpoint_payments", "label": "Payments Endpoints (/payments)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "History, outstanding balances, and signed PDF receipt downloads; receipts are signed URLs so they can be fetched by a stateless client without exposing an open document endpoint."}, {"id": "readme_endpoint_events", "label": "Calendar and Announcements Endpoints", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:34", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_dynamic_branch_pricing", "label": "Dynamic Branch Pricing (Luxury Centers)", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "is_luxury_branch and markup_percentage on the Branch model let premium locations (e.g. 20% markup for Ajah) be priced by data rather than duplicated catalogs; the Advanced Diploma series is deliberately exempted because those programs are already priced at a premium and double-marking them would distort the catalog."}, {"id": "readme_branch_model", "label": "Branch Model", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_course_pricing_updates", "label": "2026 Course Catalog Pricing", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catalog and seeder updated together so seeded environments reflect the same Certificate/Diploma/Advanced Diploma prices as production."}, {"id": "readme_userroleseeder_overhashing_fix", "label": "UserRoleSeeder Overhashing Fix", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hash::make() in the seeder combined with a model-level hashed cast double-hashed admin passwords, silently breaking default admin logins; the fix removes the explicit hash and relies on the cast alone."}, {"id": "readme_studentimporter", "label": "StudentImporter CSV Import", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:50", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_import_duplicate_resolution", "label": "Import Duplicate Resolution Cascade", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing students are matched by student_number, then email, then the first_name + last_name + phone triple; matched rows are updated with the latest financial snapshot instead of erroring or creating duplicates, so repeated imports are idempotent."}, {"id": "readme_production_deployment", "label": "Production Deployment Procedure", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:52-60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "composer install --optimize-autoloader --no-dev, migrate --force, then optimize:clear \u2014 the cache clear matters specifically because cached config/routes would otherwise serve stale auth guard definitions after API changes."}, {"id": "readme_local_development_setup", "label": "Local Development Setup", "file_type": "document", "source_file": "README.md", "source_location": "README.md:36-43", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_tenstrings_portal", "target": "readme_multi_panel_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:7", "weight": 1.0}, {"source": "readme_tenstrings_portal", "target": "readme_student_management", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:8", "weight": 1.0}, {"source": "readme_ten