{"nodes": [{"id": "prompts_inventory_module_spec", "label": "Inventory Module + Scoped Inventory Officer Role spec", "file_type": "document", "source_file": "prompts/inventory-module-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goal: a room-by-room asset register across 4 branches maintained by an Inventory Officer who can touch nothing else in the portal, with read-only CEO visibility."}, {"id": "prompts_inventory_module_spec_isolation_strategy", "label": "Three-layer isolation strategy", "file_type": "rationale", "source_file": "prompts/inventory-module-spec.md", "source_location": "1. Isolation strategy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Navigation hiding alone is not security, so isolation uses three independent layers: a separate Filament panel with its own resource discovery path (no admin route to guess), canAccessPanel() on the User model (403 rather than a redirect loop), and policies plus Spatie permission checks on every resource."}, {"id": "prompts_inventory_module_spec_inventory_panel_provider", "label": "InventoryPanelProvider", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "Layer 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_can_access_panel", "label": "User::canAccessPanel()", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "Layer 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_access_matrix_test", "label": "Role access matrix feature test", "file_type": "rationale", "source_file": "prompts/inventory-module-spec.md", "source_location": "Layer 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real feature test asserting inventory_officer gets 403 on /admin and on the student and payment resources, because this is the requirement most likely to silently regress."}, {"id": "prompts_inventory_module_spec_branches", "label": "branches table", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "2. Schema", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_inventory_categories", "label": "inventory_categories table", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "2. Schema", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_inventory_rooms", "label": "inventory_rooms table", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "2. Schema", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_inventory_items", "label": "inventory_items table", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "2. Schema", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_denormalised_branch_id", "label": "Denormalised branch_id on items", "file_type": "rationale", "source_file": "prompts/inventory-module-spec.md", "source_location": "2. Schema", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "branch_id is kept on the item even though the room implies it, because it makes branch scoping and reporting cheap and survives a room being deleted; an observer re-syncs it whenever inventory_room_id changes."}, {"id": "prompts_inventory_module_spec_inventory_movements", "label": "inventory_movements table", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "2. Schema", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_inventory_audits", "label": "inventory_audits table", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "2. Schema", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_inventory_audit_lines", "label": "inventory_audit_lines table", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "2. Schema", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_asset_tag_generation", "label": "Asset tag generation (TS-{BRANCH}-{CAT}-{0001})", "file_type": "rationale", "source_file": "prompts/inventory-module-spec.md", "source_location": "3. Asset tag generation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-generated in an InventoryItem observer when left blank, sequenced per branch + category inside a DB transaction with lockForUpdate() on the counter row so two officers saving at once cannot collide; manual override is allowed because some assets arrive with existing organisational tags."}, {"id": "prompts_inventory_module_spec_inventory_permissions", "label": "Spatie inventory permission set", "file_type": "concept", "source_file": "prompts/inventory-module-spec.md", "source_location": "4. Permissions (Spatie)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_inventory_view_all_branches", "label": "inventory.view_all_branches permission", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "4. Permissions (Spatie)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_inventory_view_costs", "label": "inventory.view_costs permission", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "4. Permissions (Spatie)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Withheld from the officer so a field role never sees purchase prices, which is usually what you actually want."}, {"id": "prompts_inventory_module_spec_item_import_permission", "label": "item.import permission", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "8. Import", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_withheld_permissions", "label": "Permissions deliberately withheld from the officer", "file_type": "rationale", "source_file": "prompts/inventory-module-spec.md", "source_location": "4. Permissions (Spatie)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "room.delete, item.delete, item.dispose, inventory.view_costs and category.manage stay with CEO/super admin, because deletion and disposal are how an asset register gets quietly falsified; the officer instead marks an item missing or needs_repair and it surfaces on the CEO exceptions list."}, {"id": "prompts_inventory_module_spec_scoped_to_branch", "label": "ScopedToBranch trait (global branch scope)", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "5. Branch scoping", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A global Eloquent scope constrains every query to the user's branch_id unless they hold inventory.view_all_branches, so scoping cannot be forgotten at the call site."}, {"id": "prompts_inventory_module_spec_room_resource", "label": "RoomResource (Filament)", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "6. Filament resources", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_item_resource", "label": "ItemResource (Filament)", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "6. Filament resources", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defaults to grouping by room.name so the table reads as a room-by-room walkthrough, matching how the officer physically works; cost fields appear only with inventory.view_costs and there is no bulk delete for the officer."}, {"id": "prompts_inventory_module_spec_needs_attention_filter", "label": "needs_attention filter", "file_type": "concept", "source_file": "prompts/inventory-module-spec.md", "source_location": "6. Filament resources", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_audit_resource", "label": "AuditResource (Filament)", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "6. Filament resources", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audit lines are auto-generated from the room's current items; on completion it updates each item's last_verified_at, writes variances to a report and sets room.last_audited_at."}, {"id": "prompts_inventory_module_spec_category_resource", "label": "CategoryResource (Filament)", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "6. Filament resources", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_inventory_overview", "label": "InventoryOverview dashboard", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "6. Pages / widgets", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_mobile_capture", "label": "Mobile audit capture page", "file_type": "rationale", "source_file": "prompts/inventory-module-spec.md", "source_location": "7. Mobile capture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The officer walks rooms with a phone, so the audit page is a stripped custom Livewire page (one item per row, big +/- stepper, sticky save). Saving per line rather than per audit means a dropped connection loses one row, not an hour of counting."}, {"id": "prompts_inventory_module_spec_photo_upload_field", "label": "FileUpload image editor with camera capture", "file_type": "code", "source_file": "prompts/inventory-module-spec.md", "source_location": "7. Mobile capture", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_inventory_module_spec_csv_import", "label": "Anti-duplicate CSV importer pattern", "file_type": "concept", "source_file": "prompts/inventory-module-spec.md", "source_location": "8. Import", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches on serial_number first, then branch_code + room_code + name + brand, and reports skipped duplicates rather than failing the whole batch."}, {"id": "prompts_inventory_module_spec_audit_trail", "label": "Activity-log audit trail", "file_type": "rationale", "source_file": "prompts/inventory-module-spec.md", "source_location": "9. Audit trail", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every create/update/delete on inventory_items and inventory_rooms is logged with spatie/laravel-activitylog including acting user and branch, surfaced as a read-only History tab, so when the CEO asks why 6 fans became 4 the answer is one click away."}, {"id": "prompts_inventory_module_spec_acceptance_checklist", "label": "Inventory acceptance checklist", "file_type": "document", "source_file": "prompts/inventory-module-spec.md", "source_location": "10. Acceptance checklist", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [