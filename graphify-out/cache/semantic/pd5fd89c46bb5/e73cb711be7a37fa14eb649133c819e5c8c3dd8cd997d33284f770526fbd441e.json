{"nodes": [{"id": "instructions_api_integration_blueprint", "label": "API Integration Blueprint Brief", "file_type": "document", "source_file": "instructions.md", "source_location": "instructions.md:1-7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An architect-persona prompt asking for a structured blueprint to layer a clean, secure REST API over the existing live Laravel + Filament portal for a mobile counterpart app."}, {"id": "instructions_stateless_constraint", "label": "Stateless API vs Stateful Filament Constraint", "file_type": "rationale", "source_file": "instructions.md", "source_location": "instructions.md:5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filament and Livewire rely on stateful session authentication, so the new mobile API must be stateless and its auth setup must coexist with the existing admin panel without breaking it \u2014 this is stated as the crucial constraint driving the whole design."}, {"id": "instructions_authentication_strategy", "label": "Sanctum Authentication Strategy", "file_type": "concept", "source_file": "instructions.md", "source_location": "instructions.md:20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step-by-step token authentication with Laravel Sanctum, explicitly ensuring Sanctum guards do not conflict with Filament's session guards."}, {"id": "instructions_api_route_blueprint", "label": "API Route Blueprint", "file_type": "concept", "source_file": "instructions.md", "source_location": "instructions.md:22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A structured endpoint list in routes/api.php following strict RESTful naming conventions, mirroring the portal's core modules."}, {"id": "instructions_controller_architecture_decision", "label": "Hand-Written Controllers vs Filament REST Plugin", "file_type": "rationale", "sourc