onale": "Published core views drift from upstream and break on Filament upgrades, so the grid and grouping must come from the PHP Table Builder API alone; unavoidable CSS goes through FilamentView::registerRenderHook() scoped to ListInventoryItems::class so it cannot leak into other pages."}, {"id": "prompts_ui_prompt_filamentview_renderhook", "label": "FilamentView::registerRenderHook() scoped CSS escape hatch", "file_type": "concept", "source_file": "prompts/ui_prompt.md", "source_location": "line 16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_ui_prompt_fileupload_room_image", "label": "FileUpload::make('image') on room form", "file_type": "code", "source_file": "prompts/ui_prompt.md", "source_location": "line 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets category/room images be uploaded and edited in place, which is what makes the collapsed room headers and the card grid readable."}, {"id": "prompts_ui_prompt_inventorytransfer", "label": "InventoryTransfer model and migration", "file_type": "code", "source_file": "prompts/ui_prompt.md", "source_location": "line 11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tracks item_id, destination (event or campus name), type and date so equipment leaving a room has an auditable trail."}, {"id": "prompts_ui_prompt_transfer_type_enum", "label": "Transfer type enum (internal, external_event, return)", "file_type": "concept", "source_file": "prompts/ui_prompt.md", "source_location": "line 11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_ui_prompt_transfer_action_modal", "label": "Action::make('transfer') modal", "file_type": "code", "source_file": "prompts/ui_prompt.md", "source_location": "line 14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A table action collects destination, type and date, then writes the InventoryTransfer row and updates the item's status in one submission, so the log and the item state cannot drift apart."}], "edges": [{"source": "prompts_ui_prompt_inventoryitemresource", "target": "prompts_ui_prompt_content_grid_layout", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/ui_prompt.md", "source_location": "lines 3-5", "weight": 1.0}, {"source": "prompts_ui_prompt_inventoryitemresource", "target": "prompts_ui_prompt_room_grouping_collapsed", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/ui_prompt.md", "source_location": "line 5", "weight": 1.0}, {"source": "prompts_ui_prompt_room_grouping_collapsed", "target": "prompts_ui_prompt_inventoryroomresource", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/ui_prompt.md", "source_location": "line 5", "weight": 1.0}, {"source": "prompts_ui_prompt_inventoryroomresource", "target": "prompts_ui_prompt_fileupload_room_image", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/ui_prompt.md", "source_location": "lines 7-8", "weight": 1.0}, {"source": "prompts_ui_prompt_transfer_action_modal", "target": "prompts_ui_prompt_inventorytransfer", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/ui_prompt.md", "source_location": "line 14", "weight": 1.0}, {"source": "prompts_ui_prompt_inventoryitemresource", "target": "prompts_ui_prompt_transfer_action_modal", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/ui_prompt.md", "source_location": "lines 13-14", "weight": 1.0}, {"source": "prompts_ui_prompt_inventorytransfer", "target": "prompts_ui_prompt_transfer_type_enum", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/ui_prompt