{"nodes": [{"id": "prompts_prompt", "label": "Room grid, room photos and event check-out/return spec", "file_type": "document", "source_file": "prompts/prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_prompt_read_before_you_write", "label": "Step 0 - inspect before changing", "file_type": "rationale", "source_file": "prompts/prompt.md", "source_location": "Step 0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The agent must first summarise existing models, image storage, roles and branch scoping, then propose a migration list and wait for approval; all migrations must be additive, never dropping or renaming columns that hold existing data."}, {"id": "prompts_prompt_broken_thumbnail_fix", "label": "Broken item thumbnail fix", "file_type": "rationale", "source_file": "prompts/prompt.md", "source_location": "Step 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Images must be fixed before building anything that depends on them; likely causes are a missing php artisan storage:link, files on a private disk, a wrong APP_URL, or the column rendering a raw path instead of a URL."}, {"id": "prompts_prompt_room_grid", "label": "Room grid landing view", "file_type": "concept", "source_file": "prompts/prompt.md", "source_location": "Step 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the collapsible grouped item list with clickable room cards (photo, name, branch, item count, badge for items out at events), responsive 1/2/3-4 columns, staying inside the existing dark Filament theme with amber accent and quiet card chrome."}, {"id": "prompts_prompt_room_page", "label": "Room view page", "file_type": "concept", "source_file": "prompts/prompt.md", "source_location": "Step 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_prompt_all_items_table", "label": "All items flat table", "file_type": "rationale", "source_file": "prompts/prompt.md", "source_location": "Step 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A flat Rooms/All items toggle is kept so someone searching for \"Yamaha keyboard\" does not have to open rooms one by one."}, {"id": "prompts_prompt_room_photos", "label": "Inventory room photos", "file_type": "concept", "source_file": "prompts/prompt.md", "source_location": "Step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Images only, max ~5 MB, resized server-side to ~1600px with a thumbnail conversion for the grid, using whatever image approach the project already uses (a cover single-file collection if Media Library is installed)."}, {"id": "prompts_prompt_inventory_room_update_photo", "label": "inventory_room.update_photo permission", "file_type": "code", "source_file": "prompts/prompt.md", "source_location": "Step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dedicated \"Change photo\" action rather than full room edit rights, enforced in the policy and not just by hiding the button, so a branch manager cannot accidentally alter room names or branches or touch another branch's rooms."}, {"id": "prompts_prompt_inventory_checkouts", "label": "inventory_checkouts table", "file_type": "code", "source_file": "prompts/prompt.md", "source_location": "Step 4 - Data model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modelled as an event-level checkout with item lines so one concert can cover many instruments and support partial returns; responsible person is stored as name + phone because they may not be a portal user."}, {"id": "prompts_prompt_inventory_checkout_items", "label": "inventory_checkout_items table", "file_type": "code", "source_file": "prompts/prompt.md", "source_location": "Step 4 - Data model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each line carries condition_out/condition_in reusing the existing item condition values rather than inventing new ones, plus returned_quantity, received_by and a return_status of returned_ok / returned_damaged / missing."}, {"id": "prompts_prompt_inventory_checkout_photos", "label": "inventory_checkout_photos table (stage out/in)", "file_type": "code", "source_file": "prompts/prompt.md", "source_location": "Step 4 - Data model", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_prompt_availability_rules", "label": "Checkout availability rules", "file_type": "rationale", "source_file": "prompts/prompt.md", "source_location": "Step 4 - Availability rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Available quantity = item quantity minus quantity out on unreturned lines; over-checkout and lost/under-repair/disposed items are blocked, and checkout and return run in DB transactions with row locks on the items so two people cannot both take the last unit."}, {"id": "prompts_prompt_checked_out_status", "label": "checked_out item status", "file_type": "concept", "source_file": "prompts/prompt.md", "source_location": "Step 4 - Availability rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fully-out item shows as checked out and reverts to its previous status when everything is back; a damaged return sets the item condition to what was recorded and flags it."}, {"id": "prompts_prompt_checkout_flow", "label": "Check-out wizard flow", "file_type": "concept", "source_file": "prompts/prompt.md", "source_location": "Step 4 - Check-out flow", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four steps - event details, items with available quantity, condition and at least 2 required photos, review and confirm - triggered from the room page row action, an All items bulk action, or a New checkout button. Upload opens the camera on phones because this is mostly done on a phone at the door."}, {"id": "prompts_prompt_return_flow", "label": "Return wizard flow", "file_type": "concept", "source_file": "prompts/prompt.md", "source_location": "Step 4 - Return flow", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supports partial return; shows the original checkout photos alongside the return photos so the receiver can compare before and after on the spot. Status becomes returned when all lines are back, partially_returned otherwise."}, {"id": "prompts_prompt_photo_evidence_rule", "label": "Photo evidence trail rule", "file_type": "rationale", "source_file": "prompts/prompt.md", "source_location": "Step 4 - Hard rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 2-photos-per-line minimum is validated server-side in the action/service, not just marked required in the form, and once confirmed photos cannot be deleted or replaced by anyone below admin because they are the evidence trail; admin changes are logged."}, {"id": "prompts_prompt_inventory_checkout_service", "label": "InventoryCheckoutService", "file_type": "code", "source_file": "prompts/prompt.md", "source_location": "Step 4 - Hard rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "checkout() and return() live in a service called by the Filament actions so the mobile API can reuse the same logic later."}, {"id": "prompts_prompt_event_checkouts_page", "label": "Event checkouts page", "file_type": "concept", "source_file": "prompts/prompt.md", "source_location": "Step 4 - Checkouts page and history", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_prompt_checkout_history_relation_manager", "label": "Item checkout history relation manager", "file_type": "concept", "source_file": "prompts/prompt.md", "source_location": "Step 4 - Checkouts page and history", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_prompt_overdue_command", "label": "Daily overdue checkout command", "file_type": "code", "source_file": "prompts/prompt.md", "source_location": "Step 4 - Overdue and alerts", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_prompt_overdue_notifications", "label": "Overdue and damage notifications", "file_type": "concept", "source_file": "prompts/prompt.md", "source_location": "Step 4 - Overdue and alerts", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_prompt_inventory_checkout_view", "label": "inventory_checkout.view permission", "file_type": "code", "source_file": "prompts/prompt.md", "source_location": "Step 4 - Permissions", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_prompt_inventory_checkout_create", "label": "inventory_checkout.create permission", "file_type": "code", "source_file": "prompts/prompt.md", "source_location": "Step 4 - Permissions", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_prompt_inventory_checkout_return", "label": "inventory_checkout.return permission", "file_type": "code", "source_file": "prompts/prompt.md", "source_location": "Step 4 - Permissions", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_prompt_acceptance_checklist", "label": "Checkout acceptance checklist", "file_type": "document", "source_file": "prompts/prompt.md", "source_location": "Acceptance checklist", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "prompts_prompt", "target": "prompts_prompt_read_before_you_write