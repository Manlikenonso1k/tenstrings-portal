{"nodes": [{"id": "docs_inventory_module_guide", "label": "Inventory Module Implementation Guide", "file_type": "document", "source_file": "docs/inventory-module-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_inventory_module_guide_inventory_panel_route", "label": "/inventory panel route", "file_type": "code", "source_file": "docs/inventory-module-guide.md", "source_location": "Access and URLs", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_inventory_module_guide_inventory_login_route", "label": "/inventory/login route", "file_type": "code", "source_file": "docs/inventory-module-guide.md", "source_location": "Access and URLs", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_inventory_module_guide_admin_users_create_route", "label": "/admin/users/create route", "file_type": "code", "source_file": "docs/inventory-module-guide.md", "source_location": "Access and URLs", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_inventory_module_guide_super_admin_role", "label": "super_admin role", "file_type": "concept", "source_file": "docs/inventory-module-guide.md", "source_location": "Roles", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_inventory_module_guide_ceo_role", "label": "ceo role (read-only, all branches, costs)", "file_type": "concept", "source_file": "docs/inventory-module-guide.md", "source_location": "Roles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CEO needs oversight across every branch including purchase costs, but must not be able to write, so the register cannot be altered from the top."}, {"id": "docs_inventory_module_guide_inventory_officer_role", "label": "inventory_officer role", "file_type": "concept", "source_file": "docs/inventory-module-guide.md", "source_location": "Roles", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_inventory_module_guide_branch_manager_role", "label": "branch_manager role", "file_type": "concept", "source_file": "docs/inventory-module-guide.md", "source_location": "Roles", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_inventory_module_guide_branch_restriction", "label": "Three-place branch restriction", "file_type": "rationale", "source_file": "docs/inventory-module-guide.md", "source_location": "Roles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Branch restriction is enforced in three places - model query scope, policies for direct links, and create/import handling - so an officer cannot reach another branch by guessing a URL or by picking another branch in a form or the CSV import dialog."}, {"id": "docs_inventory_module_guide_inventory_csv_import", "label": "Ajah inventory CSV import", "file_type": "concept", "source_file": "docs/inventory-module-guide.md", "source_location": "Importing the Ajah inventory CSV", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs synchronously on the connection so the completion result is visible before the page returns, instead of disappearing into a queue the officer cannot see."}, {"id": "docs_inventory_module_guide_csv_header_mapping", "label": "CSV header mapping (TENSTRINGS OFFICE NAME, ITEM CODE, ITEM)", "file_type": "concept", "source_file": "docs/inventory-module-guide.md", "source_location": "Importing the Ajah inventory CSV", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_inventory_module_guide_leading_quantity_parsing", "label": "Leading quantity parsing (\"6 chairs\")", "file_type": "rationale", "source_file": "docs/inventory-module-guide.md", "source_location": "Importing the Ajah inventory CSV", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source sheets bury quantity in the item text, so the importer splits a leading number into quantity and keeps the remainder as the item name; duplicate asset tags and duplicate items in the same branch/room are skipped rather than failing the batch."}, {"id": "docs_inventory_module_guide_equipment_photos", "label": "Equipment photo and notes upload", "file_type": "concept", "source_file": "docs/inventory-module-guide.md", "source_location": "Equipment photos", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_inventory_module_guide_inventory_permission_seeder", "label": "InventoryPermissionSeeder", "file_type": "code", "source_file": "docs/inventory-module-guide.md", "source_location": "Production deploy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must be re-run on every deploy that changes role permissions, because role-permission state lives in the database rather than in code."}, {"id": "docs_inventory_module_guide_production_deploy", "label": "Inventory production deploy steps", "file_type": "document", "source_file": "docs/inventory-module-guide.md", "source_location": "Production deploy", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_inventory_module_guide", "target": "docs_inventory_module_guide_inventory_panel_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/inventory-module-guide.md", "source_location": "Access and URLs", "weight": 1.0}, {"source": "docs_inventory_module_guide", "target": "docs_inventory_module_guide_inventory_login_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/inventory-module-guide.md", "source_location": "Access and URLs", "weight": 1.0}, {"source": "docs_inventory_module_guide", "target": "