{"nodes": [{"id": "prompts_payment_knowledge", "label": "Payment System Knowledge Base", "file_type": "document", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_payment_knowledge_tgipay_gateway", "label": "TgiPayGateway", "file_type": "code", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "1. How TGI Titan Works Here", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-to-server flow authenticated with an integration-key header instead of a bearer token or signature hash; amounts are sent as plain naira floats and there is no HMAC signature verification."}, {"id": "prompts_payment_knowledge_tgipay_controller", "label": "TgiPayController", "file_type": "code", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "1. How TGI Titan Works Here", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_payment_knowledge_paystack_titan_gateway", "label": "PaystackTitanGateway", "file_type": "code", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "2. How Paystack Works Here", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_payment_knowledge_kobo_conversion", "label": "Paystack kobo amount conversion", "file_type": "rationale", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "7. Lessons and Gotchas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paystack amounts must be multiplied by 100 when sending and divided by 100 when receiving, while TGIPAY uses actual naira floats - mixing the two silently produces 100x errors."}, {"id": "prompts_payment_knowledge_signature_verification", "label": "Paystack webhook signature verification", "file_type": "code", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "2. Webhook Signature Verification", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "hash_hmac('sha512', rawPayload, webhookSecret) compared with hash_equals against the x-paystack-signature header."}, {"id": "prompts_payment_knowledge_webhook_controller", "label": "WebhookController@handle", "file_type": "code", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "5. Routes", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_payment_knowledge_webhook_verification_flaw", "label": "Webhook verification flaw (hardcoded Paystack signature)", "file_type": "rationale", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "7. Lessons and Gotchas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /webhooks/{gateway} hardcodes the x-paystack-signature header and assumes isValidSignature() exists, so a tgipay webhook would fatal because TgiPayGateway does not implement it; TGIPAY is instead reconciled through the user redirect callback."}, {"id": "prompts_payment_knowledge_200_ok_on_failed_signature", "label": "200 OK on failed signature", "file_type": "rationale", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "7. Lessons and Gotchas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The controller deliberately returns 200 even when signature validation fails, to stop the gateway retrying endlessly."}, {"id": "prompts_payment_knowledge_csrf_exclusion", "label": "Webhook CSRF exclusion", "file_type": "rationale", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "7. Lessons and Gotchas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Done with ->withoutMiddleware([VerifyCsrfToken::class]) directly on the route in routes/web.php rather than through the VerifyCsrfToken exceptions array."}, {"id": "prompts_payment_knowledge_payment_service", "label": "PaymentService", "file_type": "code", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "3. The Database", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "handleWebhook() is the single reconciliation point: it sets status/payment_status, amount_paid, processed_at, receipt_number and metadata.receipt_path, then cascades into StudentCourseFee, Student balances and PaymentAdvice. reconcileTgiPayPayment() verifies TGIPAY status out-of-band."}, {"id": "prompts_payment_knowledge_payments_table", "label": "payments table", "file_type": "code", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "3. The Database", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_payment_knowledge_redundant_status_tracking", "label": "Redundant payment status tracking", "file_type": "rationale", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "7. Lessons and Gotchas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "payments carries both the legacy payment_status (paid/partial/pending) and the modern status (pending/processing/success/failed); both must be written during reconciliation to avoid breaking legacy code."}, {"id": "prompts_payment_knowledge_student_course_fee", "label": "StudentCourseFee", "file_type": "code", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "3. The Database", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_payment_knowledge_payment_advice", "label": "PaymentAdvice", "file_type": "code", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "3. The Database", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_payment_knowledge_document_service", "label": "DocumentService::generateReceiptPdf", "file_type": "code", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "4. What Happens After Payment", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Receipt PDFs are generated with Barryvdh\\DomPDF from the pdf.receipt view, passing the Payment with student and invoice relations loaded."}, {"id": "prompts_payment_knowledge_payment_controller", "label": "PaymentController", "file_type": "code", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "5. Routes", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_payment_knowledge_fee_workflow_controller", "label": "FeeWorkflowController", "file_type": "code", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "5. Routes", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_payment_knowledge_gateway_config_keys", "label": "Gateway .env config keys", "file_type": "concept", "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "6. Config Keys", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "prompts_payment_knowledge", "target": "prompts_payment_knowledge_tgipay_gateway", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "1. How TGI Titan Works Here", "weight": 1.0}, {"source": "prompts_payment_knowledge", "target": "prompts_payment_knowledge_paystack_titan_gateway", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "2. How Paystack Works Here", "weight": 1.0}, {"source": "prompts_payment_knowledge_tgipay_controller", "target": "prompts_payment_knowledge_tgipay_gateway", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "prompts/PAYMENT_KNOWLEDGE.md", "source_location": "1. Ho