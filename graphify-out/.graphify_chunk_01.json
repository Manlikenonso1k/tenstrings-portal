      "id": "readme_import_duplicate_resolution",
      "label": "Import Duplicate Resolution Cascade",
      "file_type": "rationale",
      "source_file": "C:\\Users\\Tenstrings Music Ins\\Documents\\tenstrings-portal\\README.md",
      "source_location": "README.md:50",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Existing students are matched by student_number, then email, then the first_name + last_name + phone triple; matched rows are updated with the latest financial snapshot instead of erroring or creating duplicates, so repeated imports are idempotent."
    },
    {
      "id": "readme_production_deployment",
      "label": "Production Deployment Procedure",
