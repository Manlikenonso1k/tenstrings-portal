    {
      "id": "readme_userroleseeder_overhashing_fix",
      "label": "UserRoleSeeder Overhashing Fix",
      "file_type": "rationale",
      "source_file": "C:\\Users\\Tenstrings Music Ins\\Documents\\tenstrings-portal\\README.md",
      "source_location": "README.md:49",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Hash::make() in the seeder combined with a model-level hashed cast double-hashed admin passwords, silently breaking default admin logins; the fix removes the explicit hash and relies on the cast alone."
    },
