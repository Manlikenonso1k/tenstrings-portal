      "author": null,
      "contributor": null,
      "rationale": "Sanctum bearer tokens protect the API; its migrations ship with the standard migrate run."
    },
    {
      "id": "readme_guard_separation",
      "label": "API/Filament Guard Separation",
      "file_type": "rationale",
      "source_file": "C:\\Users\\Tenstrings Music Ins\\Documents\\tenstrings-portal\\README.md",
      "source_location": "README.md:17",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The token API is strictly separated from the web portal's session-based Filament guards, so adding mobile auth cannot break existing admin panel logins; deployments touching guards require optimize:clear."
    },
