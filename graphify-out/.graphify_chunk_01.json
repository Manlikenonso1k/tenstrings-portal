      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A fully stateless, token-based v1 RESTful API in routes/api.php for a companion mobile app; responses are standardized JSON wrapped in API Resources so the mobile client sees a stable contract independent of Eloquent model shape."
    },
    {
      "id": "readme_laravel_sanctum",
